{
  "expo": {
    "name": "Boyxon Oshxonasi",
    "slug": "boyxon-osxona",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "boyxon",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F1"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.boyxon.osxona"
    },
    "android": {
      "package": "uz.boyxon.osxona",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C8102E"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Rasm yuklash uchun ruxsat kerak"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Yetkazish manzilini aniqlash uchun ruxsat kerak"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
