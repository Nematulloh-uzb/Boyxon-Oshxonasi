# =============================================================================
# Boyxon Oshxonasi — backend sozlamalari
#
# Bu faylni `.env` deb nusxalab, qiymatlarni to'ldiring:  copy .env.example .env
# `.env` HECH QACHON git'ga qo'shilmaydi (.gitignore da bor).
#
# Kuchli kalit generatsiya qilish:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================

NODE_ENV=development
PORT=5000

# Email tasdiqlash talab qilinadimi.
#   false (standart, tavsiya etiladi) — tasdiqlanmaguncha kirish yopiq.
#   true  — kirishga ruxsat, lekin ilova "emailni tasdiqlang" deb eslatadi.
# Diqqat: email provayderi sozlanmagan bo'lsa `false` qilib qo'ysangiz, yangi
# mijozlar ro'yxatdan o'tib kira olmay qoladi (xat yuborilmaydi).
ALLOW_UNVERIFIED_LOGIN=false

# Frontend manzili. Bir nechta bo'lsa vergul bilan: https://a.uz,https://b.uz
# CORS faqat shu ro'yxatga ruxsat beradi. Birinchi manzil sitemap va
# canonical URL'lar uchun ishlatiladi.
# Cloudflare Workers'da sayt va API bitta domenda:
#   CLIENT_URL=https://boyxon-server.<subdomain>.workers.dev
CLIENT_URL=http://localhost:5173

# Proksi ortida ishlaganda (Railway/Render/Nginx) qiymatni 1 qiling.
# Proksisiz turib 1 qo'yish XAVFLI: hujumchi X-Forwarded-For sarlavhasini
# soxtalashtirib rate-limit ni chetlab o'tadi. Shuning uchun default 0.
TRUST_PROXY=0

# -----------------------------------------------------------------------------
# Baza
# -----------------------------------------------------------------------------
# Variant 1) MongoDB Atlas (doimiy ma'lumot):
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/boyxon
#
# Variant 2) Lokal MongoDB (docker-compose.yml ildizdan ishga tushiring):
#   docker compose up -d
#   MONGODB_URI=mongodb://localhost:27017/boyxon
#
# Variant 3) Tezkor lokal sinov (bazani ko'tarish shart emas):
#   npm run dev:local  — xotirada MongoDB + avtomatik demo seed

# -----------------------------------------------------------------------------
# JWT kalitlari — production uchun MAJBURIY va kamida 32 belgi
# Uchtasi BIR-BIRIDAN FARQ QILISHI shart.
# Production'da zaif/bo'sh bo'lsa server ishga tushmaydi (ataylab shunday).
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
JWT_EMAIL_VERIFY_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# -----------------------------------------------------------------------------
# Google OAuth (ixtiyoriy — bo'sh bo'lsa "Google bilan kirish" o'chadi)
# Authorized redirect URI: http://localhost:5000/api/auth/google/callback
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# -----------------------------------------------------------------------------
# Cloudinary — faqat Node (Render/lokal) uchun ixtiyoriy.
# Cloudflare Workers'da rasmlar `IMAGES` KV namespace'ida saqlanadi (wrangler.jsonc).
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Push bildirishnomalar (VAPID). Generatsiya:  npx web-push generate-vapid-keys
# Diqqat: kalitlar almashtirilsa, mavjud obunalar kuchini yo'qotadi.
# -----------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@boyxon.uz

# -----------------------------------------------------------------------------
# Email (parol tiklash, buyurtma xati, email tasdiqlash).
#
# Cloudflare Workers'da SMTP ISHLAMAYDI (Gmail `ETIMEDOUT` beradi) — HTTP
# provayder kerak. Bepul variantlar: Brevo (kuniga ~300 xat) yoki Resend.
#   1) Brevo:  https://app.brevo.com → SMTP & API → API Keys → yangi kalit
#   2) Resend: https://resend.com → API Keys
# Node (Render/lokal) uchun SMTP ham ishlaydi; Gmail'da "App password" kerak.
# `auto` mavjud kalitlarga qarab tanlaydi: Brevo → Resend → SMTP.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER=auto
BREVO_API_KEY=
RESEND_API_KEY=
# Yuboruvchi manzil. Brevo'da "Sender" sifatida tasdiqlangan bo'lishi shart.
# Masalan: Boyxon Oshxonasi <no-reply@boyxon.uz>
EMAIL_FROM=
EMAIL_FROM_NAME=Boyxon Oshxonasi

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# -----------------------------------------------------------------------------
# Boshlang'ich admin (seed orqali yaratiladi)
# ADMIN_PASSWORD: production'da kamida 12 belgi, takrorlanmaydigan bo'lishi shart.
# "Admin123!" kabi parolni ISHLATMANG — bu repo'dagi eng birinchi taxmin.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@boyxon.uz
ADMIN_PASSWORD=

# Demo hisob paroli (faqat lokal ishlab chiqish uchun; production'da seed bloklangan)
DEMO_PASSWORD=User123!
