{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boyxon-server",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "enable_nodejs_http_server_modules"
  ],
  "observability": {
    "enabled": true
  },
  "alias": {
    "iconv-lite": "./worker/iconv-lite-stub.ts",
    "mongoose": "./node_modules/mongoose/index.js"
  },
  "durable_objects": {
    "bindings": [
      { "name": "PASSWORD_HASHER", "class_name": "PasswordHasher" },
      { "name": "REALTIME_HUB", "class_name": "RealtimeHub" },
      { "name": "API_SERVER", "class_name": "ApiServer" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PasswordHasher", "RealtimeHub", "ApiServer"]
    }
  ],
  // Deploy versiyasi ID'si — ApiServer DO nomiga qo'shiladi. Aks holda eski DO
  // eski kod/muhit bilan ishlashda davom etadi (Cloudflare DO'larni deployda
  // avtomatik qayta ishga tushirmaydi).
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  // Rasm saqlash: Cloudflare KV (bepul 1 GB). Cloudinary O'zbekistonda
  // ro'yxatdan o'tishni bloklagani uchun Workers'da shu ishlatiladi.
  "kv_namespaces": [
    { "binding": "IMAGES", "id": "9faea0849867435bb08e3e973a408dbf" }
  ],
  "vars": {
    "NODE_ENV": "production",
    "TRUST_PROXY": "1",
    "PORT": "3000"
  },
  // Mijoz (React SPA) shu Worker'dan beriladi — bitta origin, CORS muammosi yo'q.
  // Avval `cd boyxon/client && npm run build` bajarilishi kerak.
  // `run_worker_first: true` — barcha so'rovlar Worker'dan o'tadi, shunda HTML
  // uchun `no-cache`, hashed asset'lar uchun `immutable` sarlavhalarini o'zimiz
  // qo'yamiz va yangi deploy darhol kuchga kiradi.
  "assets": {
    "directory": "../client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
