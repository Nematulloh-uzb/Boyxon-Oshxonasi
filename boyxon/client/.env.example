# Backend API manzili. Lokal dev'da Vite proxy ham ishlaydi (/api → :5000).
# Production'da bo'sh qoldiring — sayt bilan bir xil origin (`/api`) ishlatiladi.
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket manzili (socket emas, native WS: /ws?token=...).
# Production'da bo'sh qoldiring — API origin'idan avtomatik olinadi.
# Lokal dev'da Vite proxy ishlatishi uchun: http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# Web Push uchun VAPID open kaliti.
# Generatsiya: npx web-push generate-vapid-keys  (server .env ga ham kerak)
# Bo'sh qoldirilsa push o'chiriladi, in-app bildirishnomalar ishlaydi.
VITE_VAPID_PUBLIC_KEY=

# SEO: saytning ommaviy URL'i (canonical, hreflang, OG, robots sitemap uchun).
# Bo'sh bo'lsa: dev'da http://localhost:5173, production'da joriy origin.
# Workers'ga birinchi deploy'dan keyin aniq URL'ni yozib, qayta build qiling:
#   VITE_SITE_URL=https://boyxon-server.<subdomain>.workers.dev
VITE_SITE_URL=

# Android APK manzili. Workers Assets 25 MiB limitidan katta faylni qabul
# qilmaydi, shu sababli APK alohida joyda (masalan, R2 public URL) turadi.
# Bo'sh bo'lsa: /boyxon-mobile.apk (faqat lokal dev uchun mavjud).
VITE_APK_URL=

# Qidiruv tizimi tasdiqlash kodlari (ixtiyoriy).
# Google Search Console va Yandex Webmaster'dan olinadi.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_YANDEX_VERIFICATION=
