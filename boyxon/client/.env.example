# Backend API manzili. Lokal dev'da Vite proxy ham ishlaydi (/api → :5000).
# Production: https://api-backend-domeningiz/api
VITE_API_URL=http://localhost:5000/api

# Socket.IO server manzili (VITE_API_URL dan host/protokol o'rnida).
VITE_SOCKET_URL=http://localhost:5000

# Web Push uchun VAPID open kaliti.
# Generatsiya: npx web-push generate-vapid-keys  (server .env ga ham kerak)
# Bo'sh qoldirilsa push o'chiriladi, in-app bildirishnomalar ishlaydi.
VITE_VAPID_PUBLIC_KEY=
